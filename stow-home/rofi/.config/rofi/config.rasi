@theme "~/.cache/wal/colors-rofi-dark.rasi"

configuration {
	modes: "run,drun";
	icon-theme: "zafiro-dark";
	show-icons: true;
	terminal: "kitty";
	drun-display-format: "{icon} {name}";
	location: 0;
	disable-history: false;
	hide-scrollbar: true; 
	display-drun: "   Apps ";
	display-run: "   Run ";
	display-window: " 﩯  Window";
	display-Network: " 󰤨  Network";
}
